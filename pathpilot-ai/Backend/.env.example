# PathPilot AI Backend — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Google Gemini AI ──────────────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Supported models with structured output: gemini-2.0-flash, gemini-1.5-pro, gemini-1.5-flash
GEMINI_MODEL=gemini-2.0-flash

# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co

# Anon/publishable key (safe for client-side, used with RLS)
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here

# Service-role secret key — BACKEND ONLY. Never expose to frontend.
# Security note: The service-role key bypasses RLS. The backend enforces
# ownership in application code as a second layer of defence.
SUPABASE_SECRET_KEY=your_supabase_service_role_key_here

# ── CORS ──────────────────────────────────────────────────────────────────────
# Your React frontend URL. In production, change to your deployed domain.
FRONTEND_ORIGIN=http://localhost:5173

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development

# Maximum number of AI roadmap generations per user per hour
MAX_GENERATIONS_PER_HOUR=10

# Timeout for Gemini API calls in seconds
AI_TIMEOUT_SECONDS=60
